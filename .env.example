# The Live Tutor talks directly to the engineer-playbook-poc backend on Render.
# Override only if the backend ever moves:
# NEXT_PUBLIC_API_URL=https://engineer-playbook-poc.onrender.com

# Optional silent login for the embedded tutor. The backend has one shared
# demo login. These values are compiled into the public client bundle, so only
# use the shared demo account here — never a personal or admin credential.
# If omitted, the tutor shows an inline sign-in form instead.
# NEXT_PUBLIC_TUTOR_EMAIL=
# NEXT_PUBLIC_TUTOR_PASSWORD=
