# Required — TiPC AI Tutor auth (single shared login, no signup/user directory).
# AUTH_EMAIL=
# AUTH_PASSWORD=
# JWT_SECRET=          # required in production — see src/lib/auth.ts for why

# Optional — TiPC AI Tutor LLM providers.
# With no keys set, the app uses the free anonymous Pollinations tier (~1 req / 15s).
# Priority: OpenAI > Gemini > Groq > OpenRouter > Pollinations (authed) > Pollinations (anon).

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-3.5-turbo

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter — hard-guarded to ":free"-suffixed models only, see src/lib/llmProviders.ts
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# POLLINATIONS_API_KEY=
# LLM_MODEL=openai

# Optional — RAG doc grounding for the OpenRouter path (Postgres full-text search).
# RAG_DATABASE_URL=
